{
  "name": "CartItem",
  "type": "object",
  "properties": {
    "cart_id": {
      "type": "string",
      "description": "Parent cart id"
    },
    "product_id": {
      "type": "string"
    },
    "quantity": {
      "type": "integer",
      "default": 1
    }
  },
  "required": [
    "cart_id",
    "product_id",
    "quantity"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}